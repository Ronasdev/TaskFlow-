# Variables de docker-compose.prod.yml — copier en .env.prod (jamais commité).

# Origine publique de l'application (CORS + vérification Origin des routes d'auth)
APP_ORIGIN=https://app.example.com
WEB_PORT=8080

POSTGRES_USER=taskflow
POSTGRES_DB=taskflow
# openssl rand -base64 32
POSTGRES_PASSWORD=

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Nombre de proxies de confiance devant l'API : 1 = Nginx du conteneur web ; 2 si un LB TLS est devant
TRUST_PROXY=2
COOKIE_SECURE=true
LOG_LEVEL=info

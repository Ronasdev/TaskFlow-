NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://taskflow:taskflow@127.0.0.1:5434/taskflow?schema=public

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_ISSUER=taskflow-api
JWT_AUDIENCE=taskflow-web
REFRESH_TOKEN_TTL_DAYS=30

COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0
THROTTLE_GLOBAL_LIMIT=100
LOG_LEVEL=debug
ENABLE_SWAGGER=true
